							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"error": {
											"description": "Mensagem do erro, pronta para mostrar ao usuário",
											"type": "string"
										},
										"code": {
											"description": "Status HTTP",
											"type": "number"
										},
										"details": {
											"description": "Detalhes técnicos da falha (só em alguns erros 500)",
											"type": "string"
										},
										"retryAfter": {
											"description": "Segundos até liberar uma nova extração (só no 429)",
											"type": "number"
										}
									},
									"required": [
										"error",
										"code"
									]
								}
							}
						}
					},
