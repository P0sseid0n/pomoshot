{
	"$schema": "https://json.schemastore.org/prettierrc",
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 140,
	"semi": false,
	"singleQuote": true,
	"jsxSingleQuote": false,
	"trailingComma": "all",
	"arrowParens": "avoid",
	"bracketSpacing": true,
	"endOfLine": "lf",
	"plugins": ["@ianvs/prettier-plugin-sort-imports"],
	"importOrder": ["<BUILTIN_MODULES>", "<THIRD_PARTY_MODULES>", "", "^@pomoshot/(.*)$", "", "^[.]"],
	"importOrderTypeScriptVersion": "5.9.3",
	"overrides": [
		{
			"files": ["*.yml", "*.yaml", "*.md"],
			"options": {
				"useTabs": false,
				"tabWidth": 2
			}
		}
	]
}
